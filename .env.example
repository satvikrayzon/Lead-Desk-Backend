# Server
PORT=3000
NODE_ENV=development

# Database (MongoDB 7)
# Local MongoDB without auth (default Windows install):
MONGODB_URI=mongodb://localhost:27017/lead_recorder
# Docker MongoDB with auth (use when running docker compose):
# MONGODB_URI=mongodb://leadrecorder:leadrecorder@localhost:27017/lead_recorder?authSource=admin

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d

# AWS S3 / MinIO (S3-compatible) — set S3_ENABLED=true when ready
S3_ENABLED=false
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# AWS_REGION=ap-south-1
# S3_BUCKET_NAME=lead-recorder-recordings
# S3_ENDPOINT=http://localhost:9000

# Upload limits
MAX_UPLOAD_SIZE_MB=50

# CORS (optional, for admin panel)
CORS_ORIGIN=http://localhost:5173

# Presigned URL expiry (minutes)
PRESIGNED_URL_EXPIRY_MINUTES=15

# Audit log retention (days) — compliance note in README
AUDIT_LOG_RETENTION_DAYS=365

# Recording retention (days) — configure S3 lifecycle rule
RECORDING_RETENTION_DAYS=365

# Base API URL (for Flutter app and network access)
API_BASE_URL=http://172.17.51.195:3000
